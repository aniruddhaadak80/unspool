# ── FalkorDB (required) ──────────────────────────────────────────────
# Option A — connection URL (FalkorDB Cloud gives you one):
FALKORDB_URL=falkor://default:YOUR_PASSWORD@YOUR_HOST:6379
# Option B — host/port pieces (uncomment, leave URL empty):
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your-password
# FALKORDB_TLS=false

# ── LLM (optional — without a key the agent runs in graph-replay mode) ─
# OpenRouter (default) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Or any OpenAI-compatible endpoint:
# AGENT_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# AGENT_MODEL=openai/gpt-4o-mini

# ── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Keep-alive (production) ──────────────────────────────────────────
# FalkorDB Free instances stop after 1 day idle and are deleted after 7.
# /api/cron/keepalive is pinged by Vercel Cron (+ a GitHub Actions backup)
# to keep the instance warm and re-seed any tenant whose graph was lost.
# Set CRON_SECRET on Vercel to require `Authorization: Bearer <secret>`.
# CRON_SECRET=change-me
# KEEPALIVE_TENANTS=demo,acme,acme-staging
